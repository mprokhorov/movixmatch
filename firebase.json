{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "/posters/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }] },
      { "source": "/icons/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "**/*.@(js|css|json|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
