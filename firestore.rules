rules_version = '2';

// MovixMatch data model
//   users/{uid}                         profile: name, genres, likes, presence
//   invites/{code}                      one-time link to connect two existing profiles
//   pairs/{uidA_uidB}                   a connection (uids sorted), read markers
//     matches/{movieId}                 a film both liked
//       messages/{id}                   chat about that film
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairIdOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function pairPath(id) { return /databases/$(database)/documents/pairs/$(id); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function connectedTo(uid) { return exists(pairPath(pairIdOf(uid, me()))); }
    function memberOf(pairId) { return signedIn() && me() in get(pairPath(pairId)).data.members; }

    // a connection may only be created from a live invite of the *other* member,
    // and the invite must be deleted in the same batch, so every link works exactly once
    function inviteValid(code, members) {
      return code is string
        && exists(invitePath(code))
        && !existsAfter(invitePath(code))
        && get(invitePath(code)).data.fromUid in members
        && get(invitePath(code)).data.fromUid != me()
        && get(invitePath(code)).data.expiresAt > request.time.toMillis();
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || connectedTo(uid));
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.genres is list && request.resource.data.genres.size() <= 30;
      allow delete: if signedIn() && uid == me();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.fromUid == me();
      allow create: if signedIn() && code.size() >= 12
        && request.resource.data.fromUid == me()
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 30
        && request.resource.data.expiresAt is int;
      allow delete: if signedIn() && (resource.data.fromUid == me()
        || existsAfter(pairPath(pairIdOf(resource.data.fromUid, me()))));
    }

    match /pairs/{pairId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && pairId == pairIdOf(request.resource.data.members[0], request.resource.data.members[1])
        && inviteValid(request.resource.data.invite, request.resource.data.members);
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && me() in resource.data.members;

      match /matches/{movieId} {
        allow read, write: if memberOf(pairId);

        match /messages/{msgId} {
          allow read: if memberOf(pairId);
          allow create: if memberOf(pairId)
            && request.resource.data.uid == me()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        }
      }
    }
  }
}
