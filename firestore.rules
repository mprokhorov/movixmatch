rules_version = '2';

// MovixMatch: each couple lives in rooms/{rid}. Only its two members can read or write it.
// Seats are bound to anonymous-auth uids; a seat can be (re)claimed on a new device only with
// a secret the URL carries: the invite code (partner) or the owner key (owner).
service cloud.firestore {
  match /databases/{database}/documents {

    function roomData(rid) { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
    function signedIn() { return request.auth != null; }
    function isOwner(rid) { return signedIn() && roomData(rid).ownerUid == request.auth.uid; }
    function isPartner(rid) { return signedIn() && roomData(rid).get('partnerUid', null) == request.auth.uid; }
    function isMember(rid) { return isOwner(rid) || isPartner(rid); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /rooms/{rid} {
      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.get('partnerUid', null) == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.partnerUid == null
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 30;

      allow update: if signedIn() && (
        // a member renames themselves
        ((resource.data.ownerUid == request.auth.uid || resource.data.get('partnerUid', null) == request.auth.uid)
          && changed().hasOnly(['ownerName', 'partnerName']))
        // partner joins (or re-joins on a new device): the same batch must write joins/{uid}
        // with a code that matches a live invite
        || (request.resource.data.partnerUid == request.auth.uid
          && changed().hasOnly(['partnerUid', 'partnerName'])
          && request.resource.data.partnerName is string && request.resource.data.partnerName.size() <= 30
          && existsAfter(/databases/$(database)/documents/rooms/$(rid)/joins/$(request.auth.uid))
          && exists(/databases/$(database)/documents/rooms/$(rid)/invites/$(getAfter(/databases/$(database)/documents/rooms/$(rid)/joins/$(request.auth.uid)).data.code)))
        // owner signs in on a new device: the same batch must write ownerClaims/{uid} with a valid owner key
        || (request.resource.data.ownerUid == request.auth.uid
          && changed().hasOnly(['ownerUid'])
          && existsAfter(/databases/$(database)/documents/rooms/$(rid)/ownerClaims/$(request.auth.uid))
          && exists(/databases/$(database)/documents/rooms/$(rid)/keys/$(getAfter(/databases/$(database)/documents/rooms/$(rid)/ownerClaims/$(request.auth.uid)).data.key)))
      );

      // partner invite codes: knowing the code is the secret, so a direct get is allowed
      match /invites/{code} {
        allow get: if signedIn();
        allow list: if isMember(rid);
        allow create, delete: if isOwner(rid);
      }

      // proof-of-secret docs written together with a seat claim (see room update rule)
      match /joins/{uid} {
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.code is string
          && exists(/databases/$(database)/documents/rooms/$(rid)/invites/$(request.resource.data.code));
      }
      match /ownerClaims/{uid} {
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.key is string
          && exists(/databases/$(database)/documents/rooms/$(rid)/keys/$(request.resource.data.key));
      }

      // owner recovery keys: never readable by id, only the owner can list them
      match /keys/{key} {
        allow list, create, delete: if isOwner(rid);
      }

      // per-seat state: name, likes, read markers, presence
      match /members/{role} {
        allow read: if isMember(rid);
        allow write: if (role == 'owner' && isOwner(rid)) || (role == 'partner' && isPartner(rid));
      }

      match /matches/{movieId} {
        allow read, write: if isMember(rid);

        match /messages/{msgId} {
          allow read: if isMember(rid);
          allow create: if isMember(rid)
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        }
      }
    }
  }
}
